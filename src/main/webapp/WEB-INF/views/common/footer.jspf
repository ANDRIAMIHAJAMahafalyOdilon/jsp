        </div>
    </main>
</div>
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmActionMessage">Confirmer cette action ?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="confirmActionProceed">Confirmer</button>
            </div>
        </div>
    </div>
</div>
<script src="${pageContext.request.contextPath}/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        var modalEl = document.getElementById("confirmActionModal");
        if (!modalEl || typeof bootstrap === "undefined") return;

        var messageEl = document.getElementById("confirmActionMessage");
        var proceedBtn = document.getElementById("confirmActionProceed");
        var modal = new bootstrap.Modal(modalEl);
        var pendingAction = null;

        function openConfirm(message, actionFn) {
            messageEl.textContent = message || "Confirmer cette action ?";
            pendingAction = actionFn;
            modal.show();
        }

        proceedBtn.addEventListener("click", function () {
            modal.hide();
            if (typeof pendingAction === "function") {
                pendingAction();
            }
            pendingAction = null;
        });

        document.querySelectorAll("[data-confirm]").forEach(function (el) {
            el.addEventListener("click", function (e) {
                e.preventDefault();
                var msg = el.getAttribute("data-confirm");
                if (el.tagName === "A" && el.href) {
                    openConfirm(msg, function () { window.location.href = el.href; });
                    return;
                }
                if (el.getAttribute("data-bs-toggle") === "offcanvas") {
                    openConfirm(msg, function () {
                        var target = el.getAttribute("data-bs-target");
                        if (!target) return;
                        var offcanvasEl = document.querySelector(target);
                        if (!offcanvasEl) return;
                        var offcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                        offcanvas.show();
                    });
                }
            });
        });

        function formHasBlockingIdError(form) {
            return form && !!form.querySelector("[data-id-invalid='true']");
        }

        document.querySelectorAll("[data-confirm-submit]").forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                var form = btn.closest("form");
                if (!form) return;
                e.preventDefault();
                if (formHasBlockingIdError(form)) {
                    return;
                }
                // If form is invalid, show field feedback only (no confirmation modal).
                if (typeof window.__validateFormFields === "function") {
                    var ok = window.__validateFormFields(form);
                    if (!ok) return;
                } else if (typeof form.checkValidity === "function" && !form.checkValidity()) {
                    if (typeof form.reportValidity === "function") form.reportValidity();
                    return;
                }
                var msg = btn.getAttribute("data-confirm-submit");
                openConfirm(msg, function () {
                    if (formHasBlockingIdError(form)) {
                        return;
                    }
                    // Enforce native HTML validation (required, etc.)
                    if (typeof form.reportValidity === "function" && !form.reportValidity()) {
                        return;
                    }
                    if (typeof form.requestSubmit === "function") {
                        form.requestSubmit(btn);
                        return;
                    }
                    form.submit();
                });
            });
        });
    })();
</script>
<script>
    (function () {
        function enforceDigitsOnly(input) {
            if (!input) return;
            function sanitize() {
                input.value = (input.value || "").replace(/\D/g, "");
            }
            input.addEventListener("beforeinput", function (e) {
                if (e.inputType && e.inputType.indexOf("delete") === 0) return;
                var data = e.data;
                if (data != null && /[^0-9]/.test(data)) {
                    e.preventDefault();
                }
            });
            input.addEventListener("keydown", function (e) {
                var allowed = ["Backspace", "Delete", "ArrowLeft", "ArrowRight", "Tab", "Home", "End"];
                if (allowed.indexOf(e.key) !== -1) return;
                if (e.ctrlKey || e.metaKey) return;
                if (!/^[0-9]$/.test(e.key)) {
                    e.preventDefault();
                }
            });
            input.addEventListener("paste", function (e) {
                var txt = (e.clipboardData || window.clipboardData).getData("text");
                if (/[^0-9]/.test(txt)) {
                    e.preventDefault();
                }
            });
            input.addEventListener("drop", function (e) { e.preventDefault(); });
            input.addEventListener("input", sanitize);
            sanitize();
        }

        document.querySelectorAll("input[data-numeric-only='true']").forEach(enforceDigitsOnly);

        function setInvalid(field, message) {
            if (!field || field.disabled || field.type === "hidden" || field.readOnly) return;
            field.classList.add("is-invalid");
            // Prefer an existing bootstrap invalid-feedback right after field.
            var fb = field.nextElementSibling && field.nextElementSibling.classList && field.nextElementSibling.classList.contains("invalid-feedback")
                    ? field.nextElementSibling
                    : null;
            if (!fb) {
                var id = field.id ? (field.id + "-auto-feedback") : "";
                fb = id ? document.getElementById(id) : null;
                if (!fb) {
                    fb = document.createElement("div");
                    if (id) fb.id = id;
                    fb.className = "invalid-feedback";
                    fb.setAttribute("data-auto-feedback", "true");
                    // Keep feedback below input-group when applicable.
                    var target = field.parentElement && field.parentElement.classList.contains("input-group")
                            ? field.parentElement
                            : field;
                    target.insertAdjacentElement("afterend", fb);
                }
            }
            fb.textContent = message || "Champ invalide.";
            fb.style.display = "block";
        }

        function clearInvalid(field) {
            if (!field) return;
            field.classList.remove("is-invalid");
            // Remove auto-generated feedback even when the field has no id.
            if (field.id) {
                var byId = document.getElementById(field.id + "-auto-feedback");
                if (byId) byId.remove();
            }
            var sib = field.nextElementSibling;
            if (sib && sib.classList && sib.classList.contains("invalid-feedback") && sib.getAttribute("data-auto-feedback") === "true") {
                sib.remove();
            }
            if (field.parentElement && field.parentElement.classList && field.parentElement.classList.contains("input-group")) {
                var afterGroup = field.parentElement.nextElementSibling;
                if (afterGroup && afterGroup.classList && afterGroup.classList.contains("invalid-feedback")
                    && afterGroup.getAttribute("data-auto-feedback") === "true") {
                    afterGroup.remove();
                }
            }
        }

        function isFieldHidden(field) {
            var el = field;
            while (el && el !== document.body) {
                if (window.getComputedStyle(el).display === "none") return true;
                el = el.parentElement;
            }
            return false;
        }

        function validateFormFields(form) {
            if (!form) return true;
            // Disable native browser tooltips/messages; we show our own feedback under fields.
            if (!form.hasAttribute("novalidate")) {
                form.setAttribute("novalidate", "novalidate");
            }
            var fields = form.querySelectorAll("input, select, textarea");
            var firstInvalid = null;
            var hasInvalid = false;
            fields.forEach(function (field) {
                if (field.disabled || field.type === "hidden" || field.readOnly) return;
                if (isFieldHidden(field)) return;
                var isManual = field.getAttribute("data-manual-invalid") === "true";
                var raw = (field.value || "").trim();
                var requiredMissing = field.required && raw === "";
                // Some browsers/locales display date as dd/mm/yyyy but keep valid value internally.
                // If a date field is filled, do not flag it as missing.
                if (field.type === "date" && raw !== "") {
                    requiredMissing = false;
                }
                var invalidNative = !requiredMissing && !field.checkValidity();
                if (requiredMissing || invalidNative) {
                    // For manual-validated fields, the page-specific script already manages
                    // the exact message; we just ensure red border + feedback visibility.
                    if (!isManual) {
                        var msg = requiredMissing ? "Veuillez renseigner ce champ." : (field.validationMessage || "Champ invalide.");
                        setInvalid(field, msg);
                    } else {
                        field.classList.add("is-invalid");
                        var fb = field.nextElementSibling && field.nextElementSibling.classList && field.nextElementSibling.classList.contains("invalid-feedback")
                                ? field.nextElementSibling
                                : null;
                        if (fb) fb.style.display = "block";
                    }
                    if (!firstInvalid) firstInvalid = field;
                    hasInvalid = true;
                } else {
                    if (!isManual) {
                        clearInvalid(field);
                    } else {
                        // Keep manual fields clean when they become valid.
                        field.classList.remove("is-invalid");
                        var manualFb = field.nextElementSibling && field.nextElementSibling.classList && field.nextElementSibling.classList.contains("invalid-feedback")
                                ? field.nextElementSibling
                                : null;
                        if (manualFb) manualFb.style.display = "none";
                    }
                }
            });
            if (firstInvalid && typeof firstInvalid.focus === "function") {
                firstInvalid.focus();
            }
            return !hasInvalid;
        }

        // Expose for confirm-submit buttons so they can block the modal.
        window.__validateFormFields = validateFormFields;

        document.querySelectorAll("form").forEach(function (form) {
            if (!form.hasAttribute("novalidate")) {
                form.setAttribute("novalidate", "novalidate");
            }
            form.addEventListener("submit", function (e) {
                var ok = validateFormFields(form);
                if (!ok) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            });

            form.addEventListener("input", function (e) {
                var field = e.target;
                if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
                if (field.getAttribute("data-manual-invalid") === "true") return;
                if (field.classList.contains("is-invalid") && field.checkValidity()) {
                    clearInvalid(field);
                }
            });
            form.addEventListener("change", function (e) {
                var field = e.target;
                if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
                if (field.getAttribute("data-manual-invalid") === "true") return;
                if (field.classList.contains("is-invalid") && field.checkValidity()) {
                    clearInvalid(field);
                }
            });
        });

        var flash = document.getElementById("globalFlashAlert");
        if (flash && flash.getAttribute("data-auto-hide") === "true" && typeof bootstrap !== "undefined") {
            setTimeout(function () {
                var alertInstance = bootstrap.Alert.getOrCreateInstance(flash);
                alertInstance.close();
            }, 500);
        }
    })();
</script>
</body>
</html>
