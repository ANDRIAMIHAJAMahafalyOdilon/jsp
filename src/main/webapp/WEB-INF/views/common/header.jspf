<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestion Reservation Cooperative</title>
    <link rel="icon" href="${pageContext.request.contextPath}/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-width: 280px;
            --header-height: 80px;
        }
        * { box-sizing: border-box; }
        html, body {
            overflow-x: hidden !important; /* Strongly prevent horizontal scroll */
        }
        body {
            background: #ffffff;
            color: #1f2937;
            overflow-x: hidden; /* Prevent horizontal scrollbars */
        }
        .app-shell {
            min-height: 100vh;
            overflow-x: clip; /* Prevent horizontal scrollbars without breaking sticky */
            max-width: 100%;
        }
        .app-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: #212529;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            overflow: hidden;
            z-index: 1030;
        }
        .app-sidebar .brand {
            font-weight: 700;
            letter-spacing: 0.2px;
        }
        .app-sidebar .nav-link {
            color: rgba(255, 255, 255, 0.88);
            border-radius: 10px;
            padding: 0.7rem 0.85rem;
            margin-bottom: 0.35rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .app-sidebar .nav-link:hover,
        .app-sidebar .nav-link.active {
            background: #343a40;
            color: #fff;
        }
        .app-main {
            width: calc(100% - var(--sidebar-width));
            background: #ffffff;
            height: 100vh;
            padding-top: var(--header-height);
            margin-left: var(--sidebar-width);
            overflow-x: clip;
            overflow-y: auto;
            max-width: 100%;
            min-width: 0;
        }
        .topbar {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            overflow-x: hidden; /* Prevent navbar scroll on smaller screens */
            white-space: normal;
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: var(--header-height);
            z-index: 1045;
            width: auto; /* Let fixed left/right define the usable width */
            max-width: calc(100vw - var(--sidebar-width));
            overflow-y: hidden;
            padding: 0 20px !important;
            box-sizing: border-box;
        }
        .topbar, .topbar * {
            min-width: 0; /* Avoid flex overflow pushing the bar */
        }
        .page-block {
            background: #fff;
            border: 1px solid #d8dee8;
            border-radius: 14px;
            box-shadow:
                0 2px 4px rgba(16, 24, 40, 0.10),
                0 14px 30px rgba(16, 24, 40, 0.12);
        }
        .table > :not(caption) > * > * {
            padding: 0.85rem 0.75rem;
        }
        .btn {
            border-radius: 10px;
        }
        .card {
            border-radius: 14px;
            border: 1px solid #dce3ee;
            box-shadow:
                0 2px 4px rgba(16, 24, 40, 0.08),
                0 12px 24px rgba(16, 24, 40, 0.10);
        }

        .page-content {
            padding: 30px;
        }
        @media (max-width: 991.98px) {
            .app-shell {
                display: block !important;
            }
            .app-sidebar {
                width: 100%;
                min-height: auto;
                position: static;
                height: auto;
                overflow: visible;
            }
            .app-main {
                width: 100%;
                margin-left: 0;
            }
            .topbar {
                left: 0;
                right: 0;
            }
        }

        /* Make topbar search area fully shrinkable */
        .topbar .topbar-right {
            flex: 1 1 auto;
            min-width: 0;
            justify-content: flex-end;
        }
        .topbar .live-search-wrap {
            min-width: 0 !important;
            /* Responsive width: shrink to fit, never overflow */
            width: min(260px, 32vw) !important;
            max-width: min(260px, 32vw) !important;
            flex: 0 1 auto;
            overflow: hidden;
            flex-shrink: 1;
        }
        .topbar input {
            max-width: 100%;
            min-width: 0;
            width: 100%;
        }
        .topbar .fw-semibold.text-dark {
            flex: 0 1 300px;
            min-width: 0;
            word-break: normal;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
</head>
<body>
<c:set var="uri" value="${pageContext.request.requestURI}" />
<div class="d-flex app-shell">
    <aside class="app-sidebar p-3 p-lg-4 shadow d-flex flex-column">
        <div class="brand mb-4 fs-5 d-flex align-items-center gap-2">
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Cooperative Reservation</span>
        </div>
        <div class="small text-uppercase fw-semibold mb-2 opacity-75">Navigation</div>
        <nav class="nav flex-column mb-4">
            <a class="nav-link ${fn:contains(uri, '/dashboard') ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</a>
        </nav>

        <div class="small text-uppercase fw-semibold mb-2 opacity-75">Tables</div>
        <nav class="nav flex-column">
            <a class="nav-link ${fn:contains(uri, '/voitures') ? 'active' : ''}" href="${pageContext.request.contextPath}/voitures"><i class="bi bi-truck me-2"></i>Voiture</a>
            <a class="nav-link ${fn:contains(uri, '/clients') ? 'active' : ''}" href="${pageContext.request.contextPath}/clients"><i class="bi bi-people me-2"></i>Client</a>
            <a class="nav-link ${fn:contains(uri, '/reservations') ? 'active' : ''}" href="${pageContext.request.contextPath}/reservations"><i class="bi bi-journal-check me-2"></i>Reserver / Place</a>
        </nav>
        <div class="mt-auto pt-3 border-top border-secondary-subtle">
            <a class="nav-link text-white"
               href="${pageContext.request.contextPath}/logout"
               data-confirm="Confirmer la deconnexion ?">
                <i class="bi bi-box-arrow-right me-2"></i>Se deconnecter
            </a>
        </div>
    </aside>

    <main class="app-main">
        <nav class="topbar navbar d-flex justify-content-between align-items-center gap-3 flex-nowrap">
            <div class="fw-semibold text-dark" style="min-width:0; word-break: break-word;">Gestion de reservation des places</div>
            <div class="topbar-right d-flex align-items-center gap-2 flex-nowrap min-width-0">
                <c:if test="${not empty topbarSearch}">
                    ${topbarSearch}
                </c:if>
                <c:if test="${not empty topbarActions}">
                    ${topbarActions}
                </c:if>
            </div>
        </nav>
        <div class="page-content">
            <c:if test="${not empty sessionScope.flashMessage}">
                <div id="globalFlashAlert"
                     class="alert alert-${sessionScope.flashType} alert-dismissible fade show shadow-sm border-0"
                     role="alert"
                     data-auto-hide="${sessionScope.flashType == 'success'}">
                    ${sessionScope.flashMessage}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <c:remove var="flashType" scope="session" />
                <c:remove var="flashMessage" scope="session" />
            </c:if>
